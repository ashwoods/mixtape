{
  "extensions": {
    "disable": ["sentry"]
  },
  "isolates": {
    "worktree": {
      "setup": ["scripts/check --collect-only -q >/dev/null 2>&1 || true"]
    }
  },
  "lander": {
    "checks": [
      { "command": "scripts/check --lint", "timeout": 300 },
      [
        { "command": "scripts/check --tests", "timeout": 900 },
        { "command": "scripts/check --docs", "timeout": 600 }
      ]
    ]
  }
}
