#!/usr/bin/env bash
# Run every check: ruff lint, ruff format, mypy and pytest.
#
#   scripts/check [--lint] [--tests] [--docs] [PYTEST_ARGS...]
#
# --lint runs ruff and mypy, --tests the tests but the documentation's, --docs the commands
# of the documentation and its build; with none of them, all three. The rest goes to pytest,
# which runs on up to 4 workers (`-n 0` for one). It prints the load per core and the free disk
# first, and a hint when tests fail while the load is over 1.5 per core.
#
# PyGObject (`gi`) and GStreamer's Python overrides come from the system
# (Homebrew on macOS, apt on Debian/Ubuntu), not from PyPI, so the venv is
# built on the Python that has them, with its site-packages visible.
# Set MIXTAPE_PYTHON to pick that interpreter yourself; the venv goes to
# UV_PROJECT_ENVIRONMENT when set (Docker), .venv otherwise.
set -euo pipefail
cd "$(dirname "$0")/.."

lint=0 tests=0 docs=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --lint) lint=1 ;;
    --tests) tests=1 ;;
    --docs) docs=1 ;;
    *) break ;;
  esac
  shift
done
if (( !lint && !tests && !docs )); then
  lint=1 tests=1 docs=1
fi
venv="${UV_PROJECT_ENVIRONMENT:-.venv}"

# The load per core: the tests that bound a time fail on a busy machine whatever the code does
load() {
  local load
  if [[ -r /proc/loadavg ]]; then
    load="$(cut -d' ' -f1 /proc/loadavg)"
  else
    load="$(sysctl -n vm.loadavg | awk '{print $2}')"  # "{ 1.23 2.34 3.45 }"
  fi
  awk -v load="$load" -v cores="$(getconf _NPROCESSORS_ONLN)" 'BEGIN {printf "%.1f", load / cores}'
}
free="$(df -Pk . | awk 'NR == 2 {printf "%.0f", $4 / 1048576}')"
echo "load $(load) per core, $free GB free"
[[ "$venv" = /* ]] || venv="$PWD/$venv"

has_gst() {
  "$1" -c 'import gi; gi.require_version("Gst", "1.0"); from gi.repository import Gst' 2>/dev/null
}

if [[ ! -x "$venv/bin/python" ]] || ! has_gst "$venv/bin/python"; then
  python=""
  brew_python=""
  if command -v brew >/dev/null; then
    brew_python="$(brew --prefix)/bin/python3"
  fi
  for candidate in "${MIXTAPE_PYTHON:-}" "$brew_python" /usr/bin/python3; do
    if [[ -n "$candidate" && -x "$candidate" ]] && has_gst "$candidate"; then
      python="$candidate"
      break
    fi
  done
  if [[ -z "$python" ]]; then
    echo "No Python with gi and GStreamer found. Install them first:" >&2
    echo "  macOS:  brew install gstreamer" >&2
    echo "  Ubuntu: apt install python3-gi python3-gst-1.0 gstreamer1.0-plugins-base gstreamer1.0-plugins-good" >&2
    exit 1
  fi
  uv venv --clear --system-site-packages --python "$python" "$venv"
fi

# Pin uv to the venv's Python, so a UV_PYTHON or global `uv python pin`
# cannot make `uv sync` replace the venv with one that has no gi.
export UV_PYTHON="$venv/bin/python"
uv sync --locked
if ! has_gst "$venv/bin/python"; then
  echo "uv sync replaced $venv with a Python that has no gi; remove it and run again." >&2
  exit 1
fi
if (( lint )); then
  uv run --no-sync ruff check
  uv run --no-sync ruff format --check
  uv run --no-sync mypy
fi

docs_tests=(tests/test_doc_samples.py tests/test_docs.py)
selection=()
if (( tests && !docs )); then
  for path in "${docs_tests[@]}"; do selection+=("--ignore=$path"); done
elif (( docs && !tests )); then
  selection=("${docs_tests[@]}")
fi
if (( tests || docs )); then
  # loadgroup: the tests of one xdist_group (the x264 encodes) run one after another
  status=0
  uv run --no-sync pytest -n auto --maxprocesses 4 --dist loadgroup ${selection[@]+"${selection[@]}"} "$@" \
    || status=$?
  if (( status == 1 )) && awk -v load="$(load)" 'BEGIN {exit !(load > 1.5)}'; then
    echo "The load is $(load) per core: a test that bounds a time or a timeout may have failed because of it; run the failures again once the machine is quieter." >&2
  fi
  exit "$status"
fi
