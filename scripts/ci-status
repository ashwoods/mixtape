#!/usr/bin/env bash
# Where GitHub Actions is with a commit: one line per job of its CI and docs runs, and at once,
# without waiting for them.
#
#   scripts/ci-status [COMMIT]
#
# COMMIT defaults to HEAD. Exits 0 once every job has passed, 1 when one failed or was
# cancelled, and 8 while one is still queued or running, a workflow has no run yet, or `gh` could
# not reach GitHub (as `gh pr checks` does), so a loop can poll it:
#
#   until scripts/ci-status; [[ $? != 8 ]]; do sleep 30; done
set -euo pipefail
cd "$(dirname "$0")/.."

sha="$(git rev-parse --verify "${1:-HEAD}^{commit}")"
repo="${MIXTAPE_REPO:-ashwoods/mixtape}"

# a failing `gh` (the network, the API) is a status not known yet
gh_() {
  local out
  if ! out="$(gh "$@")"; then
    echo "gh failed" >&2
    exit 8
  fi
  printf '%s' "$out"
}

# the newest run of each workflow for a push or a pull request of the commit (not the docs run
# after a release): a re-run, or a pull request's run before the push to main, is replaced by
# the later one; unique_by keeps the first of each, and the list is newest first
runs="$(gh_ run list --repo "$repo" --commit "$sha" --limit 50 --json databaseId,workflowName,event \
  --jq '[.[] | select((.workflowName == "CI" or .workflowName == "docs")
                      and (.event == "push" or .event == "pull_request"))]
        | unique_by(.workflowName) | .[] | "\(.workflowName) \(.databaseId)"')"

lines=""
for workflow in CI docs; do
  run="$(awk -v w="$workflow" '$1 == w {print $2}' <<<"$runs")"
  order=$([[ $workflow == CI ]] && echo 1 || echo 2)
  if [[ -z "$run" ]]; then
    lines+="$order"$'\t…\t'"$workflow"$'\tno run yet\t-\t-\n'
    continue
  fi
  # one line per job, or one for the run while it has none: queued before GitHub made them, or
  # failed to start (an invalid workflow file)
  lines+="$(gh_ run view "$run" --repo "$repo" --json status,conclusion,url,jobs --jq '
    def mark: if .status != "completed" then "…" elif .conclusion == "success" then "✓"
              else "✗" end;
    def state: if .status != "completed" then .status else .conclusion end;
    def took: if .startedAt == "0001-01-01T00:00:00Z" or .startedAt == null then "-"
              else ((if .status == "completed" then (.completedAt | fromdate) else now end)
                    - (.startedAt | fromdate) | floor
                    | "\(. / 60 | floor)m\(. % 60 | tostring
                                           | if length < 2 then "0" + . else . end)s")
              end;
    [.jobs[] | select(.conclusion != "skipped")] as $jobs
    | if $jobs == [] then ["'"$order"'", mark, "'"$workflow"'", state, "-", .url]
      else $jobs[] | ["'"$order"'", mark,
                      (if "'"$workflow"'" == "CI" then .name else "docs " + .name end),
                      state, took, .url]
      end
    | @tsv')"$'\n'
done

echo "${sha:0:7}:"
# CI's jobs (Ubuntu rs, Ubuntu stock, macOS), then docs'
printf '%s' "$lines" | LC_ALL=C sort -t $'\t' -k1,1 -k3,3 | cut -f2- | column -t -s $'\t' \
  | sed 's/^/  /'
if grep -q $'\t✗\t' <<<"$lines"; then
  exit 1
elif grep -q $'\t…\t' <<<"$lines"; then
  exit 8
fi
